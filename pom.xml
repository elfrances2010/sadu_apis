<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Identificación del proyecto -->
    <groupId>com.sadu</groupId>
    <artifactId>sadu_apis</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>sadu_apis</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 17 compatible con NetBeans y Tomcat 9 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <failOnMissingWebXml>false</failOnMissingWebXml>
        <!-- Versión de webapp-runner: sirve para correr el WAR como si fuera
             un jar ejecutable en Railway -->
        <webapp-runner.version>9.0.68.0</webapp-runner.version>
    </properties>

    <!--
        IMPORTANTE: Todas las dependencias deben estar DENTRO de este
        único bloque <dependencies>. No puede haber etiquetas <dependency>
        fuera de este bloque o Maven lanzará un error de POM malformado.
    -->
    <dependencies>

        <!-- Servlet API para Tomcat 9 (javax.servlet) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <!-- "provided" significa que Tomcat ya la incluye en tiempo de ejecución -->
            <scope>provided</scope>
        </dependency>

        <!-- JSTL: permite usar etiquetas <c:forEach>, <c:if>, etc. en JSP -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Conector MySQL: permite conectar Java con la base de datos MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- org.json: librería para parsear y construir objetos JSON.
             Usada en ApiColombiaServlet para leer la respuesta de la API. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>

        <!-- Google Gson: manipulación de JSON en servlets territoriales -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

    </dependencies>

    <!-- FIN del bloque de dependencias — no agregar <dependency> después de esta línea -->

    <build>
        <!-- Nombre del archivo WAR generado al compilar -->
        <finalName>sadu_apis</finalName>

        <plugins>
            <!-- Descarga webapp-runner.jar a target/ en cada build.
                 Railway usará ese jar para levantar el .war como servidor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-webapp-runner</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.github.jsimone</groupId>
                                    <artifactId>webapp-runner</artifactId>
                                    <version>${webapp-runner.version}</version>
                                    <destFileName>webapp-runner.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Repositorio donde vive webapp-runner -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

</project>
